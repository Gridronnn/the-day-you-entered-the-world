# Server Environment Configuration
# Copy this file to .env or configure these variables in Vercel Project Settings -> Environment Variables.
# NEVER commit .env files containing real secret keys to source control.

# 1. GoldAPI.io (Optional - For Live Gold Spot Prices)
# Obtain key at: https://www.goldapi.io/
# When omitted, the app displays official London Bullion Market Association (LBMA) / Reserve Bank of India (RBI) benchmarks with status "delayed".
GOLDAPI_KEY=

# 2. U.S. Energy Information Administration (EIA) API (Optional - For Live Weekly U.S. Retail Gasoline)
# Obtain key at: https://www.eia.gov/opendata/register.php
# When omitted, the app displays official published EIA weekly surveyed retail series.
EIA_API_KEY=

# 3. U.S. Bureau of Labor Statistics (BLS) API (Optional - For Live Monthly CPI-U Updates)
# Obtain key at: https://data.bls.gov/registrationEngine/
# When omitted, the app displays the official published BLS historical CPI-U series (1913-present).
BLS_API_KEY=

# 4. Upstash Redis (Optional - For Shared Serverless Cache & Rate Limiting on Vercel)
# Obtain at: https://upstash.com/
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
